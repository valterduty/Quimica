                        <path d="M50,90 Q100,30 150,55 Q200,65 230,65" stroke="#E53935" stroke-width="3" fill="none"/>
                        <text x="70" y="35" font-size="11" fill="#E53935">Sem enzima</text>
                        
                        <!-- Com enzima (linha pontilhada, pico mais baixo) -->
                        <path d="M50,90 Q100,60 150,55 Q200,65 230,65" stroke="#43A047" stroke-width="3" fill="none" stroke-dasharray="6,4"/>
                        <text x="155" y="48" font-size="11" fill="#43A047">── Com enzima</text>
                        
                        <text x="48" y="105" font-size="11">A</text>
                        <text x="228" y="80" font-size="11">B</text>
